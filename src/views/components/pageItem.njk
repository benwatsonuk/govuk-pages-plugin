{% macro pageItem(params) %}

    <div class="govuk-pages-plugin__page__item {% if params.page.newPage %}govuk-pages-plugin__page__item--new{% endif %}{% if params.page.hasIteration %}govuk-pages-plugin__page__item--updated{% endif %}">
        <a class="govuk-pages-plugin__pages__link" href="{{ params.page.route }}" data-overview-page-link="./page/{{params.page.id}}" data-direct-link="{{ params.page.route }}">
        {{ params.page.title }}
        </a>
    </div>

{% endmacro %}