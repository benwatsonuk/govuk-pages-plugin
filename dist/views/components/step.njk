{% macro govukPagesPluginStep(step) %}
    <div class="govuk-pages-plugin__flows__step">
    <a href="{{ step.route }}" class="govuk-pages-plugin__flows__step" data-overview-page-link="./page/{{step.id}}" data-direct-link="{{ step.route }}">
        <div class="govuk-pages-plugin__screen-icon {% if step.type %}govuk-pages-plugin__screen-icon--{{ step.type }}{% endif%}"></div>
        {{ step.title }}
    </a>
    <div class="govuk-pages-plugin__flows__connector"></div>
</div>
{% endmacro %}